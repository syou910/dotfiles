prefix_rule(pattern=["git", "init", "-b", "main"], decision="allow")
prefix_rule(pattern=["git", "clone"], decision="allow")
prefix_rule(pattern=["npm", "view"], decision="allow")
prefix_rule(pattern=["corepack", "pnpm"], decision="allow")
prefix_rule(pattern=["npx", "--yes", "pnpm@11.7.0"], decision="allow")
prefix_rule(pattern=["git", "status", "--short"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "diff", "--check"], decision="allow")
prefix_rule(pattern=["git", "add", "README.md", "docs/decisions/0004-dsh-subagent-adapter.md", "src/dsh", "tests/dsh-agent-executor.test.ts", "tests/dsh-json-schema.test.ts"], decision="allow")
prefix_rule(pattern=["git", "add", "README.md", "package.json", "scripts/test-dsh-source.mjs", "tests/dsh-source-integration.test.ts", "docs/decisions/0005-source-integration-gate.md"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["/opt/homebrew/bin/zsh", "-lc", "COTERIUM_ROOT=/Users/kubo/Projects/coterium DSH_SOURCE_ROOT=/private/tmp/coterium-dsh-reference node scripts/test-dsh-source.mjs"], decision="allow")
prefix_rule(pattern=["node", "dist/index.js", "run"], decision="allow")
prefix_rule(pattern=["./node_modules/.bin/tsx", "src/index.ts", "ui"], decision="allow")
prefix_rule(pattern=["kill", "49238"], decision="allow")
prefix_rule(pattern=["git", "-c", "protocol.file.allow=always", "submodule", "add"], decision="allow")
prefix_rule(pattern=["git", "submodule", "set-url", "thirdparty/deepseek-harness", "https://github.com/deepseek-ai/deepseek-harness.git"], decision="allow")
prefix_rule(pattern=["npx", "--yes", "bun@1.3.14"], decision="allow")
prefix_rule(pattern=["git", "diff", "--cached", "--check"], decision="allow")
prefix_rule(pattern=["sed", "-n", "1,260p", "src/github/gherkin-task.ts"], decision="allow")
prefix_rule(pattern=["gh", "--version"], decision="allow")
prefix_rule(pattern=["gh", "issue", "create"], decision="allow")
prefix_rule(pattern=["./node_modules/.bin/tsx", "src/index.ts", "run-issue"], decision="allow")

# GitHub readonly 用ラッパー (書き込み不可トークン)
prefix_rule(
    pattern = ["ghro"],
    decision = "allow",
    justification = "ghro is a read-only GitHub CLI wrapper using a write-disabled token",
    match = [
        "ghro api repos/syou910/dotfiles/commits",
        "ghro issue list --repo syou910/dotfiles",
        "ghro pr view 1",
    ],
)
