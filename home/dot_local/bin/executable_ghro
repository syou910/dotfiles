#!/bin/sh
# GitHub readonly 用 gh ラッパー
# キーチェーン共有を避けるため、専用トークンファイルを使う
TOKEN_FILE="${HOME}/.config/ghro/token"
if [ ! -r "$TOKEN_FILE" ]; then
  echo "ghro: missing token file: $TOKEN_FILE" >&2
  echo "Create a fine-grained read-only PAT and run:" >&2
  echo "  pbpaste > ~/.config/ghro/token && chmod 600 ~/.config/ghro/token" >&2
  exit 1
fi
export GH_TOKEN
GH_TOKEN="$(cat "$TOKEN_FILE")"
export GH_CONFIG_DIR="${HOME}/.config/ghro"
exec gh "$@"
